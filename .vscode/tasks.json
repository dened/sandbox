 {
   // Документацию по формату tasks.json можно найти по ссылке:
   // https://go.microsoft.com/fwlink/?LinkId=733558
   "version": "2.0.0",
   "tasks": [
     {
       "label": "Run build_runner",
       "command": "dart",
       "args": [
         "run",
         "build_runner",
         "build",
         "--delete-conflicting-outputs"
       ],
       "type": "shell",
       "group": {
         "kind": "build",
         "isDefault": true
       },
       "presentation": {
         "reveal": "always",
         "panel": "shared",
         "showReuseMessage": false,
         "clear": true
       },
       "problemMatcher": []
     },
     {
       "label": "Update Golden Files",
       "command": "flutter",
       "args": ["test", "--update-goldens"],
       "type": "shell",
       "group": "test",
       "presentation": {
         "reveal": "always",
         "panel": "shared",
         "showReuseMessage": false,
         "clear": true
       },
       "problemMatcher": []
     }
   ]
 }